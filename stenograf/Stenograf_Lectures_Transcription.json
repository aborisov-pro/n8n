{
  "name": "Стенограф — Расшифровка лекций",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        2432,
        64
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "bucket_name",
              "value": "YOUR_S3_BUCKET",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "disk_folder",
              "value": "/YOUR_DISK_FOLDER/merged",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Set: Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2656,
        64
      ]
    },
    {
      "parameters": {
        "url": "https://cloud-api.yandex.net/v1/disk/resources",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "path",
              "value": "={{ $('Set: Config').item.json.disk_folder }}"
            },
            {
              "name": "media_type",
              "value": "audio"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "name": "List Disk Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2880,
        64
      ]
    },
    {
      "parameters": {
        "url": "https://YOUR_SUPABASE_URL.supabase.co/rest/v1/lectures_transcripts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "disk_path,status"
            }
          ]
        },
        "options": {}
      },
      "name": "Get Existing Paths",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3104,
        64
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const diskItems = $('List Disk Files').first().json._embedded?.items || [];\nconst existingArr = $input.all().map(i => i.json);\nconst skipSet = new Set(\n  existingArr\n    .filter(r => r && (r.status === 'done' || r.status === 'processing' || r.status === 'merged'))\n    .map(r => r.disk_path)\n);\nconst bucket = $('Set: Config').first().json.bucket_name;\n\nreturn diskItems\n  .filter(f => f.type === 'file' && !skipSet.has(f.path))\n  .map(f => {\n    const m = f.name.match(/^(.+)_part(\\d+)\\.mp3$/);\n    const lecture_base = m ? m[1] : f.name.replace(/\\.mp3$/, '');\n    const part_index = m ? parseInt(m[2], 10) : 1;\n    return {\n      json: {\n        disk_path: f.path,\n        file_name: f.name,\n        mime_type: f.mime_type || 'audio/mpeg',\n        bucket_name: bucket,\n        s3_key: 'lectures/' + f.name,\n        lecture_base,\n        part_index\n      }\n    };\n  });"
      },
      "name": "Filter New Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3328,
        64
      ]
    },
    {
      "parameters": {
        "method": "HEAD",
        "url": "=https://storage.yandexcloud.net/{{ $('Set: Config').item.json.bucket_name }}/{{ $json.s3_key }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "name": "Check S3 Exists",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3488,
        64
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "s3exists",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF S3 Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3648,
        64
      ]
    },
    {
      "parameters": {
        "url": "https://cloud-api.yandex.net/v1/disk/resources/download",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "path",
              "value": "={{ $('Filter New Files').item.json.disk_path }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Get Download URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3808,
        176
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.href }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "name": "Download File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3968,
        176
      ]
    },
    {
      "parameters": {
        "operation": "upload",
        "bucketName": "={{ $('Set: Config').item.json.bucket_name }}",
        "fileName": "={{ $('Filter New Files').item.json.file_name }}",
        "additionalFields": {
          "acl": "publicRead",
          "parentFolderKey": "lectures"
        }
      },
      "name": "Upload to S3",
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        4128,
        176
      ]
    },
    {
      "parameters": {},
      "name": "Merge Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        4288,
        64
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://transcribe.api.cloud.yandex.net/speech/stt/v2/longRunningRecognize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"config\": {\n    \"specification\": {\n      \"languageCode\": \"ru-RU\",\n      \"model\": \"deferred-general\",\n      \"audioEncoding\": \"MP3\",\n      \"profanityFilter\": false\n    }\n  },\n  \"audio\": {\n    \"uri\": \"https://storage.yandexcloud.net/{{ $('Set: Config').item.json.bucket_name }}/{{ $('Filter New Files').item.json.s3_key }}\"\n  }\n}",
        "options": {}
      },
      "name": "Submit to SpeechKit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        4448,
        64
      ]
    },
    {
      "parameters": {
        "tableId": "lectures_transcripts",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "disk_path",
              "fieldValue": "={{ $('Filter New Files').item.json.disk_path }}"
            },
            {
              "fieldId": "file_name",
              "fieldValue": "={{ $('Filter New Files').item.json.file_name }}"
            },
            {
              "fieldId": "s3_key",
              "fieldValue": "={{ $('Filter New Files').item.json.s3_key }}"
            },
            {
              "fieldId": "operation_id",
              "fieldValue": "={{ $json.id }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "processing"
            },
            {
              "fieldId": "lecture_base",
              "fieldValue": "={{ $('Filter New Files').item.json.lecture_base }}"
            },
            {
              "fieldId": "part_index",
              "fieldValue": "={{ $('Filter New Files').item.json.part_index }}"
            }
          ]
        }
      },
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        4608,
        64
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 50
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        2432,
        576
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "bucket_name",
              "value": "YOUR_S3_BUCKET",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Set: Config (Schedule)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2600,
        576
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "lectures_transcripts",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "processing"
            }
          ]
        }
      },
      "name": "Get Processing Records",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2800,
        576
      ]
    },
    {
      "parameters": {
        "url": "=https://operation.api.cloud.yandex.net/operations/{{ $json.operation_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Check Operation Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        3000,
        576
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and",
          "options": {}
        },
        "options": {}
      },
      "name": "Is Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3200,
        576
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e1",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Has Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3400,
        576
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const chunks = $json.response && $json.response.chunks ? $json.response.chunks : [];\nconst text = chunks\n  .map(c => c.alternatives && c.alternatives[0] ? c.alternatives[0].text : '')\n  .filter(t => t)\n  .join('\\n');\nconst dbRecord = $('Get Processing Records').item.json;\nreturn { json: { transcript: text, record_id: dbRecord.id, s3_key: dbRecord.s3_key } };"
      },
      "name": "Extract Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        672
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "lectures_transcripts",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.record_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "done"
            },
            {
              "fieldId": "transcript",
              "fieldValue": "={{ $json.transcript }}"
            }
          ]
        }
      },
      "name": "Update Done",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        3800,
        672
      ]
    },
    {
      "parameters": {
        "operation": "delete",
        "bucketName": "={{ $('Set: Config (Schedule)').item.json.bucket_name }}",
        "fileKey": "={{ $('Extract Transcript').item.json.s3_key }}",
        "options": {}
      },
      "name": "Delete from S3",
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        4000,
        672
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "lectures_transcripts",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "operation_id",
              "condition": "eq",
              "keyValue": "={{ $('Check Operation Status').item.json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "error"
            },
            {
              "fieldId": "error_msg",
              "fieldValue": "={{ JSON.stringify($json.error) }}"
            }
          ]
        }
      },
      "name": "Update Error",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        3600,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_URL.supabase.co/rest/v1/rpc/try_merge_lecture",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n \"p_base\": \"{{ $('Get Processing Records').item.json.lecture_base }}\"\n}",
        "options": {}
      },
      "name": "Try Merge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        4200,
        672
      ]
    }
  ],
