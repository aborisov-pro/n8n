              "id": "fn3",
              "name": "command",
              "value": "={{ 'mkdir -p /mnt/data/backups/supabase && pg_dump \"' + $env.SUPABASE_DB_CONN + '\" --format=custom --file=/mnt/data/backups/supabase/backup_' + $now.format('yyyy-MM-dd_HHmm') + '.dump && echo __SUCCESS__ || echo __FAILED__' }}",
