      "parameters": {
        "jsCode": "const raw = ($input.first().json.output || $input.first().json.text || '').trim();\nconst cleaned = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```$/i, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = {\n    title: raw.substring(0, 80) || 'Без названия',\n    description: raw,\n    category: 'other',\n    status: 'new',\n    priority: 3,\n    tags: ['parse-error'],\n    source: 'Telegram',\n    notes: 'Ошибка парсинга: ' + e.message\n  };\n}\nif (!parsed.status) parsed.status = 'new';\nif (!parsed.source) parsed.source = 'Telegram';\nif (!parsed.priority) parsed.priority = 3;\nif (!Array.isArray(parsed.tags)) parsed.tags = [];\nreturn [{ json: parsed }];\n"
      },
