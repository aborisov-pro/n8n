    {
      "parameters": {
        "jsCode": "// Классификатор — без LLM\n// true-ветка «Это календарь?» = calendar\n// false-ветка = idea (включая идеи с датой)\n\nconst text = (\n  $input.first().json.message?.text ||\n  ''\n).toLowerCase();\n\nconst hasDate = (\n  /\\b\\d{1,2}[\\.\\/]\\d{1,2}/.test(text) ||\n  /завтра|послезавтра|сегодня/.test(text) ||\n  /понедельник|вторник|среда|среду|четверг|пятниц|суббот|воскресень|\\bвс\\b|\\bпн\\b|\\bвт\\b|\\bср\\b|\\bчт\\b|\\bпт\\b|\\bсб\\b/.test(text) ||\n  /январ|феврал|март|апрел|\\bмай\\b|\\bмая\\b|июн|июл|август|сентябр|октябр|ноябр|декабр/.test(text) ||\n  /\\b\\d{1,2}:\\d{2}\\b/.test(text) ||\n  /\\bв \\d{1,2}\\b/.test(text) ||\n  /\\bутра\\b|\\bвечера\\b|\\bночи\\b|\\bднём\\b|\\bдня\\b/.test(text)\n);\n\nconst hasIdeaWord = /\\bидея\\b|\\bидею\\b|\\bидеи\\b/.test(text);\n\n// Только явное событие без маркера «идея» -> календарь\nconst route = (hasDate && !hasIdeaWord) ? 'calendar' : 'idea';\n\nconst src = $input.first().json;\nconst raw_text = src.message?.text || '';\nreturn [{ json: { ...src, _route: route, _text: raw_text } }];\n"
      },
